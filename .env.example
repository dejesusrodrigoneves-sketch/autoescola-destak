# Copie para .env e preencha. Nunca comite o .env.
# Nenhum valor real neste arquivo.

NODE_ENV=development
PORT=3000

# Banco local: PostgreSQL 16 instalado na maquina (sem Docker).
# Crie o papel e o banco uma vez, conforme o README.
# Em producao: pooler na DATABASE_URL e conexao direta na DIRECT_URL.
DATABASE_URL=postgresql://destak:destak@localhost:5432/destak
DIRECT_URL=postgresql://destak:destak@localhost:5432/destak

# Redis entra na fase 5 (filas e limite de requisicoes). Vazio por enquanto.
# REDIS_URL=redis://localhost:6379

# Sessao
JWT_SECRET=
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Asaas (sandbox em desenvolvimento)
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Evolution API (vazio = envio simulado)
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=

# Supabase (Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media-dev

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
